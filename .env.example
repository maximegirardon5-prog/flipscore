# Copie ce fichier en ".env" puis remplis les valeurs.
# Le fichier .env n'est jamais envoyé sur GitHub (voir .gitignore).

# Environnement : development | test | production
APP_ENV=development

# Base de données. Par défaut : fichier SQLite local, aucune installation.
# En production : l'URL PostgreSQL fournie par Supabase
# (format : postgresql+psycopg://utilisateur:motdepasse@hote:5432/postgres)
DATABASE_URL=sqlite:///./flipscore.db

# Niveau de détail des journaux : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Mot de passe de l'interface web (phase interface)
WEB_PASSWORD=change-moi

# Bot Telegram (phase alertes) : jeton donné par @BotFather et ton identifiant de chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# IA : fournisseur (none | gemini) et clé API. "none" = aucune IA appelée.
AI_PROVIDER=none
AI_API_KEY=
# Plafond de dépense IA par mois, en centimes (0 = palier gratuit uniquement)
AI_MONTHLY_BUDGET_CENTS=0

# eBay Browse API (phase 2)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Boîte Gmail dédiée aux e-mails d'alerte Leboncoin/Vinted (phase 2)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
